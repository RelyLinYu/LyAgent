/* LyAgent flat surface layer.
 *
 * Loaded last so it overrides the exported design platform values without
 * touching the generated Figma sheet. Goals: hairline separation instead of
 * glow, tighter radii, a cooler surface ladder and a single accent. Menu
 * material stays owned by gradient-shadow-text.css, so this sheet declares no
 * menu fill or backdrop token. Light theme is untouched; every override is
 * scoped to the dark theme.
 */

body,
body * {
  --dsw-elevation-panel: var(--dsw-elevation-stroke);
  --dsw-elevation-prominent: var(--dsw-elevation-stroke);
  --dsw-elevation-soft: var(--dsw-elevation-stroke);
  --dsw-radius-panel: 14px;
  --dsw-radius-xl: 12px;
  --dsw-radius-lg: 10px;
  --dsw-radius-md: 8px;
}

body[data-ds-dark-theme] {
  /* Cool near-black canvas with a five-step surface ladder. */
  --dsw-static-neutral-bluish-950: #0c0d0e;
  --dsw-static-neutral-bluish-900: #111314;
  --dsw-static-neutral-bluish-875: #151819;
  --dsw-static-neutral-bluish-850: #181b1c;
  --dsw-static-neutral-bluish-800: #1d2122;

  --dsw-alias-border-l1: rgba(255, 255, 255, 0.05);
  --dsw-alias-border-l2: rgba(255, 255, 255, 0.09);
  --dsw-alias-border-l3: rgba(255, 255, 255, 0.13);
  --dsw-alias-border-l4: rgba(255, 255, 255, 0.17);

  /* One accent carries every "this is live / this passed" signal. Interactive
   * fills are aliased through button-info-* and state-business-primary, so the
   * accent has to be applied there; brand-primary-new-color alone reaches no
   * surface. */
  --dsw-alias-brand-primary-new-color: #3ddc97;
  --dsw-alias-button-info-fill: #3ddc97;
  --dsw-alias-button-info-hover: #57e8a8;
  --dsw-alias-state-business-primary: #3ddc97;

  /* The sidebar column paints its own fill from this token; the pill carries the
     material now, so the column behind it stays transparent. */
  --dsw-specific-sidebar-fill: transparent;
}

/* The session archive manager contributes its own header links (an upstream
 * repository and an issue tracker). A deployment that productizes this surface
 * does not show them, so the row is hidden without touching the plugin. The
 * plugin injects its own stylesheet after this one, hence the explicit priority. */
.dsham_settingsLinks,
body .dsham_settingsLinks {
  display: none !important;
}

/* Glass belongs to the three workbench regions — sidebar, conversation header
 * and composer — not to an outer frame: the app fills the window, and each
 * region is its own translucent pane over the canvas. */
}

/* Each region is its own floating pill: a gap on every side, including between
 * the sidebar and the stacked header/composer pills. */
/* Component stylesheets load after this one, so the pill geometry states its
 * priority explicitly. Each panel keeps a 10px gap on every side. */

}

/* Every inner box gives up its own surface; the panel is the surface. Buttons
 * keep their fills because only divs are cleared. */

/* Interactive controls keep their own fills. */
}

/* The canvas uses the same grey as the sidebar, so the workbench reads as one
 * surface with differently raised panes instead of a black void on the right. */
body[data-ds-dark-theme] {
  background: var(--dsw-static-neutral-bluish-875);
}

/* The app container paints its own opaque surface over the page; the canvas
 * gradient only becomes visible once that layer is transparent. */
body[data-ds-dark-theme] [data-slot='root'] > * {
  background: transparent !important;
}

/* The shell wraps each region in its own painted column; that backing surface
 * is what filled the gaps between the pills. Only the pills carry material. */
}

/* Narrow windows wrap the composer in a full-width dock that paints its own
 * background; only the input card should be visible, so every ancestor of the
 * composer panel stops painting. */
}

/* The submit control keeps the accent fill the flat card would otherwise erase. */
}

/* Two outlines were visible: the composer wrapper chain draws its own border
 * around the card. Only the card keeps an outline. */
}

/* Frosted liquid glass for the three region containers. One material, one
 * hairline, an inner glow only: the float comes from the gaps around them. */
}

}

}

}

/* Hover keeps the pane translucent; it only changes how much glass shows. */
}

/* Inner boxes never paint over the glass. */
/* Canvas: one fixed layer at the bottom of the stack. Everything else floats. */
body[data-ds-dark-theme]::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: -1;
  background: #151819;
  pointer-events: none;
}

/* Ancestors must not paint, filter, or become a backdrop root, or the blur has
 * nothing to sample. */
body[data-ds-dark-theme] [data-slot='root'],
body[data-ds-dark-theme] [data-slot='root'] > *,
body[data-ds-dark-theme] div:has([data-lyagent-panel]) {
  background: transparent !important;
  opacity: 1 !important;
  filter: none !important;
  backdrop-filter: none !important;
  transform: none !important;
}

/* One material for the three floating cards. */
body [data-lyagent-panel] {
  position: relative !important;
  z-index: 10 !important;
  background: rgba(24, 27, 34, 0.40) !important;
  backdrop-filter: blur(12px) saturate(130%) !important;
  -webkit-backdrop-filter: blur(12px) saturate(130%) !important;
  border: 1px solid rgba(255, 255, 255, 0.15) !important;
  box-shadow: none !important;
  border-radius: 18px !important;
}

body [data-lyagent-panel='sidebar'] {
  margin: 10px !important;
  height: calc(100% - 20px) !important;
  width: calc(100% - 20px) !important;
  border-radius: 22px !important;
}

body [data-lyagent-panel='header'] {
  margin: 10px 10px 0 20px !important;
}

body [data-lyagent-panel='composer'] {
  margin: 10px auto !important;
  width: min(820px, calc(100% - 40px)) !important;
  max-width: 820px !important;
  border-radius: 26px !important;
}

/* Inner boxes carry no fill of their own; the card is the only surface. */
body [data-lyagent-panel] > div {
  background: transparent !important;
  border-color: transparent !important;
  box-shadow: none !important;
}

/* Content sits above the glass. */
body [data-lyagent-panel] > div > * {
  position: relative;
  z-index: 1;
}

body [data-lyagent-panel]:hover {
  background: rgba(24, 27, 34, 0.46) !important;
}
